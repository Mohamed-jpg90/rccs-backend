# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/rccs_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# QR check-in tokens (short lived, separate secret from the login JWT)
QR_SECRET=change_this_to_another_long_random_secret
QR_TOKEN_EXPIRES_IN=15m

# File uploads
MAX_UPLOAD_SIZE_MB=5

# First Admin account (used only by: npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@rccs.com
ADMIN_PASSWORD=Admin@12345
